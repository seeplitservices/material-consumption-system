# Material Consumption & Wastage Management System - Backend Environment Configuration

# Application Port and Environment
PORT=5000
FLASK_ENV=production
DEBUG=False

# Flask & JWT Security Keys
FLASK_SECRET_KEY=generate-a-strong-random-flask-secret-key
JWT_SECRET_KEY=generate-a-strong-random-jwt-secret-key
JWT_EXPIRATION_HOURS=24

# Google Sheets API Configuration
# Paste your Google Spreadsheet ID (from the spreadsheet URL: /spreadsheets/d/<ID>/edit)
GOOGLE_SHEETS_SPREADSHEET_ID=your_google_sheets_spreadsheet_id_here

# Service Account Credentials:
# Option A: Paste the entire JSON string directly into GOOGLE_SERVICE_ACCOUNT_JSON (Recommended for Render)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Option B: Or provide the relative or absolute path to your service_account.json file
GOOGLE_SERVICE_ACCOUNT_PATH=service_account.json

# Frontend CORS Origin (e.g., https://your-app.vercel.app or http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# Industrial Constants
STEEL_DENSITY_COEFFICIENT=0.00000785
BASELINE_DATE=2026-11-01
CACHE_TTL_SECONDS=30
